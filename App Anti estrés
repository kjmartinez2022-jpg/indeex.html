    signs:["Cansancio que no se quita al descansar","Sentirte distante, indiferente o cínico con el trabajo","Sensación de que nada de lo que haces alcanza","Pérdida de motivación y de sentido","Aislarte de compañeros","Irritabilidad o tristeza frecuentes"],
    cons:["Agotamiento físico y emocional","Baja satisfacción y motivación","Ausencias y deseo de dejar el trabajo","Impacto en la vida personal y familiar"],
    tips:["Define una hora de cierre y respétala.","Silencia notificaciones del trabajo fuera de horario.","Recupera algo que disfrutes fuera del trabajo.","Habla con alguien de confianza sobre cómo te sientes.","Usa tus días libres y vacaciones para descansar de verdad.","Si las señales se mantienen por semanas, busca apoyo profesional."]
  }
};
var COMPARE = [
  ["Cómo se siente","“Tengo demasiado”: urgencia y prisa","“Ya no me queda nada”: vacío"],
  ["Energía","Acelerada, pero se agota","Muy baja, incluso tras descansar"],
  ["Emociones","Reactivas: ansiedad, irritación","Apagadas: distancia, indiferencia"],
  ["Relación con el trabajo","Hay compromiso, aunque cueste","Desconexión y pérdida de sentido"],
  ["Duración","Puede ser puntual","Se instala con el tiempo (crónico)"]
];
var FACTS = [
  { n:"12 000 millones", t:"de días de trabajo se pierden cada año por depresión y ansiedad, con un costo cercano a 1 billón de dólares en productividad.", s:"OMS, 2022 — Directrices sobre la salud mental en el trabajo" },
  { n:"15 %", t:"de los adultos en edad de trabajar vive con un trastorno mental en algún momento.", s:"OMS — Hoja informativa “La salud mental en el trabajo”" },
  { n:"+35 %", t:"de riesgo de accidente cerebrovascular al trabajar 55 horas o más por semana, frente a 35-40 horas.", s:"OMS y OIT, 2021" },
  { n:"2019", t:"La OMS incluyó el burnout en la CIE-11 como “fenómeno ocupacional”, no como condición médica.", s:"OMS, CIE-11" }
];
var learnTab = "estres";

function renderLearn(body){
  var L = LEARN[learnTab];
  function block(icon, title, arr){ return '<div class="card"><h3>' + icon + ' ' + title + '</h3><ul class="list">' + arr.map(function(x){ return '<li><span class="dot"></span>' + esc(x) + '</li>'; }).join("") + '</ul></div>'; }
  body.innerHTML = '<div class="seg" role="tablist" aria-label="Tema"><button role="tab" aria-selected="' + (learnTab === "estres") + '" data-lt="estres">Estrés laboral</button><button role="tab" aria-selected="' + (learnTab === "burnout") + '" data-lt="burnout">Burnout laboral</button></div>' +
    '<div class="card teal"><p class="eyebrow">¿Qué es?</p><h2>' + L.name + '</h2><p style="margin:0;color:var(--mint)">' + esc(L.def) + '</p></div>' +
    '<div class="grid2" style="grid-template-columns:1fr">' + block("🔍", "Causas frecuentes", L.causes) + block("🚦", "Señales de alerta", L.signs) + block("⚠️", "Consecuencias", L.cons) + '</div>' +
    '<h2 style="margin-top:20px">Consejos prácticos</h2><p class="small muted">Desliza para ver los 6 →</p><div class="hscroll" tabindex="0" aria-label="Consejos prácticos">' + L.tips.map(function(t, i){ return '<article class="tip"><span class="n">' + (i + 1) + '</span><p style="margin:0;font-weight:600">' + esc(t) + '</p></article>'; }).join("") + '</div>' +
    '<h2 style="margin-top:16px">Estrés vs. burnout</h2><table class="compare"><thead><tr><th scope="col"></th><th scope="col">Estrés</th><th scope="col">Burnout</th></tr></thead><tbody>' + COMPARE.map(function(r){ return '<tr><td>' + esc(r[0]) + '</td><td>' + esc(r[1]) + '</td><td>' + esc(r[2]) + '</td></tr>'; }).join("") + '</tbody></table>' +
    '<h2 style="margin-top:20px">Datos que importan</h2><div class="grid2" style="grid-template-columns:1fr">' + FACTS.map(function(f){ return '<div class="card mint" style="margin:0"><div style="font-family:var(--font-display);font-weight:800;font-size:1.7rem;color:var(--teal)">' + esc(f.n) + '</div><p style="margin:0 0 6px">' + esc(f.t) + '</p><p class="small muted" style="margin:0">Fuente: ' + esc(f.s) + '</p></div>'; }).join("") + '</div>' +
    '<a class="btn btn-gold btn-block" href="#plan/termometro" style="margin-top:16px">🌡️ ¿Cómo estoy yo? Hacer el termómetro</a>';
  body.onclick = function(e){ var b = e.target.closest("[data-lt]"); if (b){ learnTab = b.getAttribute("data-lt"); renderLearn(body); $("[data-lt=" + learnTab + "]", body).focus(); } };
}

function renderHelp(body){
  function telLink(n){ var d = String(n).replace(/[^\d+]/g, ""); return /^\+?\d{3,}$/.test(d) ? d : null; }
  function res(title, arr){ return '<div class="card"><h3>' + title + '</h3>' + arr.map(function(r){ return '<a class="res-link" href="' + esc(r.url) + '" target="_blank" rel="noopener"><span><b>' + esc(r.title) + '</b><br><span class="small muted">' + esc(r.by) + '</span></span><span aria-hidden="true">↗</span></a>'; }).join("") + '</div>'; }
  body.innerHTML = '<div class="notice alert" role="note"><span aria-hidden="true">🆘</span><div><b>' + esc(CONFIG.crisisText) + '</b><div class="row" style="margin-top:10px"><a class="btn btn-primary btn-sm" href="tel:911">📞 Llamar al 911</a></div></div></div>' +
    '<h2 style="margin-top:18px">Líneas de ayuda en El Salvador</h2>' +
    CONFIG.helpLines.map(function(l){
      var w = l.whatsapp ? String(l.whatsapp).replace(/[^\d]/g, "") : "";
      var t = telLink(l.number);
      var href = w ? ' href="https://wa.me/' + esc(w) + '" target="_blank" rel="noopener"' : (t ? ' href="tel:' + t + '"' : '');
      var tag = w ? 'a' : (t ? 'a' : 'div');
      var icon = w ? '💬' : (t ? '📞' : '');
      return '<' + tag + href + ' class="help-line"><span class="gi" aria-hidden="true">' + l.icon + '</span><span style="flex:1"><b>' + esc(l.name) + '</b><span class="small muted">' + esc(l.detail) + '</span><br><span class="num">' + U.verifyTag(l.number) + '</span></span>' + (icon ? '<span aria-hidden="true">' + icon + '</span>' : '') + '</' + tag + '>';
    }).join("") +
    res("📚 Lecturas", CONFIG.resources.readings) + res("🎬 Videos", CONFIG.resources.videos) + res("📱 Apps recomendadas", CONFIG.resources.apps) +
    '<footer class="foot">🔒 Esta herramienta no recopila datos personales. <button class="btn btn-ghost btn-sm" data-clear style="margin-top:8px">Borrar mis datos</button></footer>';
  body.onclick = function(e){ if (e.target.closest("[data-clear]")) U.clearAll(); };
}

/* Envío anónimo a Google Forms (si está configurado en CONFIG.googleForm) */
function sendForm(data){
  var G = CONFIG.googleForm;
  if (!G.formAction){ PCE.toast("El buzón aún no está conectado. Pide a quien administra la herramienta que agregue el enlace."); return Promise.resolve(false); }
  var p = new URLSearchParams();
  Object.keys(data).forEach(function(k){ if (data[k] && G.fields[k]) p.append(G.fields[k], data[k]); });
  return fetch(G.formAction, { method:"POST", mode:"no-cors", body:p }).then(function(){ PCE.toast("¡Gracias! Tu mensaje llegó de forma anónima 💚"); return true; }, function(){ PCE.toast("No hay conexión. Intenta de nuevo más tarde."); return false; });
}
var survey = {};
function renderVoice(body){
  var connected = !!CONFIG.googleForm.formAction;
  var QS = [
    { k:"q1", q:"¿Te ayudó tomar una pausa con esta herramienta?", o:["Sí, mucho","Un poco","Todavía no"] },
    { k:"q2", q:"¿Con qué frecuencia la usarías?", o:["Todos los días","Algunas veces por semana","De vez en cuando"] },
    { k:"q3", q:"¿Qué te gustaría encontrar aquí?", o:["Más juegos","Más pausas guiadas","Más apoyo profesional","Actividades en equipo"] }
  ];
  body.innerHTML = '<div class="notice mint"><span aria-hidden="true">🔒</span><div><b>Tu voz es anónima.</b> No pedimos nombre, correo ni datos personales. Evita escribir información que te identifique.</div></div>' +
    (connected ? '' : '<p class="notice small" style="margin-top:10px">⚙️ El buzón está listo, pero aún no se conecta a un formulario. Mientras tanto, los envíos no se guardan.</p>') +
    '<div class="card" style="margin-top:14px"><h3>Reacción rápida</h3><p class="small muted">¿Qué te pareció esta herramienta?</p><div class="moods" role="group" aria-label="Reacción">' +
      [["😍","Me encanta"],["🙂","Me gusta"],["😐","Normal"],["🙁","Poco útil"],["💡","Tengo ideas"]].map(function(r){ return '<button class="mood" data-react="' + r[1] + '"><span class="e" aria-hidden="true">' + r[0] + '</span>' + r[1] + '</button>'; }).join("") + '</div></div>' +
    '<div class="card"><h3>Caja de sugerencias</h3><label class="sr-only" for="sug">Tu sugerencia</label><textarea id="sug" class="field" maxlength="800" placeholder="¿Qué podríamos mejorar en el trabajo o en esta herramienta?"></textarea><button class="btn btn-primary btn-block" style="margin-top:10px" data-sug>Enviar sugerencia anónima</button></div>' +
    '<div class="card"><h3>Encuesta de 3 preguntas</h3>' + QS.map(function(q){ return '<p class="q-label" id="l' + q.k + '">' + esc(q.q) + '</p><div class="chips" role="radiogroup" aria-labelledby="l' + q.k + '" style="margin-bottom:14px">' + q.o.map(function(o){ return '<button class="chip" role="radio" aria-checked="' + (survey[q.k] === o) + '" data-q="' + q.k + '" data-o="' + esc(o) + '">' + esc(o) + '</button>'; }).join("") + '</div>'; }).join("") +
    '<button class="btn btn-gold btn-block" data-survey>Enviar encuesta</button></div>';
  body.onclick = function(e){
    var r = e.target.closest("[data-react]"); if (r){ $$("[data-react]", body).forEach(function(x){ x.setAttribute("aria-pressed", x === r); }); sendForm({ reaction:r.getAttribute("data-react") }); return; }
    var q = e.target.closest("[data-q]"); if (q){ var k = q.getAttribute("data-q"); survey[k] = q.getAttribute("data-o"); $$('[data-q="' + k + '"]', body).forEach(function(x){ x.setAttribute("aria-checked", x === q); }); return; }
    if (e.target.closest("[data-sug]")){ var t = $("#sug", body); if (!t.value.trim()){ PCE.toast("Escribe tu sugerencia primero."); t.focus(); return; } sendForm({ suggestion:t.value.trim() }).then(function(ok){ if (ok) t.value = ""; }); return; }
    if (e.target.closest("[data-survey]")){ if (!survey.q1 && !survey.q2 && !survey.q3){ PCE.toast("Elige al menos una respuesta."); return; } sendForm({ q1:survey.q1, q2:survey.q2, q3:survey.q3 }).then(function(ok){ if (ok){ survey = {}; renderVoice(body); } }); }
  };
}

PCE.RENDER.apoyo = function(el, sub){
  var tabs = [["ayuda","💚 Ayuda"],["entender","📖 Entender"],["voz","🗣️ Tu voz"]];
  sub = tabs.some(function(t){ return t[0] === sub; }) ? sub : "ayuda";
  el.innerHTML = '<p class="eyebrow">Apoyo</p><h1 id="t-apoyo">' + (sub === "entender" ? "Entender el estrés y el burnout" : sub === "voz" ? "Tu voz cuenta" : "No estás solo ni sola") + '</h1>' +
    '<div class="seg" role="tablist" aria-label="Secciones de Apoyo">' + tabs.map(function(t){ return '<button role="tab" aria-selected="' + (t[0] === sub) + '" data-sub="' + t[0] + '">' + t[1] + '</button>'; }).join("") + '</div><div id="apoyoBody"></div>';
  $$("[data-sub]", el).forEach(function(b){ b.onclick = function(){ location.hash = "#apoyo/" + b.getAttribute("data-sub"); }; });
  var body = $("#apoyoBody", el);
  ({ ayuda:renderHelp, entender:renderLearn, voz:renderVoice })[sub](body);
};

/* Arranque */
PCE.route(true);
})();
</script>
</body>
</html>
