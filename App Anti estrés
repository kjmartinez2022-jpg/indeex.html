  function finish(){ spent += 0; clearInterval(timer); if (cur) cur.destroy(); cur = null; showClosing(ov, beforeMood); }
  var timer = setInterval(function(){
    var now = performance.now(), dt = (now - lastTs) / 1000; lastTs = now;
