function BreathCircle(pattern, opts){
  opts = opts || {};
  var big = reduceMotion ? 1.35 : 1.9;
  var phases = [
    { k:"in",   label:"Inhala", secs:pattern[0], s:big },
    { k:"hold", label:"Sostén", secs:pattern[1], s:big },
    { k:"out",  label:"Exhala", secs:pattern[2], s:1 },
    { k:"hold2",label:"Sostén", secs:pattern[3] || 0, s:1 }
  ].filter(function(p){ return p.secs > 0; });
  var cycle = phases.reduce(function(a, p){ return a + p.secs; }, 0);
  var el = h('<div class="breath" ' + (opts.interactive ? 'role="button" tabindex="0" aria-label="Mantén presionado mientras inhalas y sostienes; suelta al exhalar"' : 'aria-hidden="true"') + '><div class="halo"></div><div class="core"><span class="count">4</span></div><div class="label" aria-live="off">Inhala</div></div>');
  var core = $(".core", el), label = $(".label", el), count = $(".count", el), cur = -1;
  return {
    el: el, phases: phases, cycle: cycle,
    phaseAt: function(t){ var tc = t % cycle, acc = 0; for (var i = 0; i < phases.length; i++){ if (tc < acc + phases[i].secs) return { i:i, p:phases[i], left:acc + phases[i].secs - tc }; acc += phases[i].secs; } return { i:0, p:phases[0], left:phases[0].secs }; },
    update: function(t){
      var ph = this.phaseAt(t);
      if (ph.i !== cur){ cur = ph.i; core.style.setProperty("--dur", ph.p.secs + "s"); core.style.setProperty("--s", ph.p.s); label.textContent = ph.p.label; Sound.breath(ph.p.k); }
      count.textContent = Math.ceil(ph.left);
      return ph;
    },
    core: core
  };
}
