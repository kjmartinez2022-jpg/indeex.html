<!--
  ==========================================================================
  PsicoCenter Equilibrio — herramienta de pausas para el bienestar laboral
  Un solo archivo: HTML + CSS + JavaScript. Sin backend ni librerías externas.
  - Para editar textos, enlaces, líneas de ayuda o el Google Forms:
    busca "CONFIGURACIÓN" (primer bloque de código, al inicio del body).
  - Los datos (racha, checklist, reto, termómetro) se guardan SOLO en
    localStorage del dispositivo, bajo la clave "pce.v1".
  ==========================================================================
-->
<style>
/* =========================================================================
   1. TOKENS DE DISEÑO (colores, tipografía, radios, sombras)
   ========================================================================= */
:root{
  --teal:#1F4E4A;          /* verde azulado oscuro (marca) */
  --teal-700:#2A625D;
  --teal-600:#36766F;
  --teal-950:#123330;
  --mint:#CFE8DE;          /* verde menta suave */
  --mint-50:#EEF7F2;
  --mint-200:#B7DCCD;
  --cream:#FBF7EE;         /* crema */
  --paper:#FFFFFF;
  --gold:#C9A24D;          /* dorado de acento */
  --gold-soft:#F3E6C4;
  --ink:#15302D;           /* texto principal */
  --ink-soft:#4C625F;      /* texto secundario (contraste AA sobre crema) */
  --line:#DCE7E1;
  --ok:#3E8E5F; --warn:#C28B1E; --alert:#B5473A;
  --ok-bg:#E3F2E8; --warn-bg:#FBF0D6; --alert-bg:#F8E1DD;
  --radius:22px; --radius-sm:14px; --radius-lg:30px;
  --shadow:0 10px 30px -14px rgba(31,78,74,.35);
  --shadow-soft:0 4px 14px -8px rgba(31,78,74,.3);
  --font:system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
  --font-display:ui-rounded,"SF Pro Rounded","Nunito","Segoe UI Variable Display","Segoe UI",system-ui,sans-serif;
  --nav-h:72px;
  --ease:cubic-bezier(.4,.1,.2,1);
  --slow:.6s;
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
body{margin:0;font-family:var(--font);color:var(--ink);background:var(--cream);line-height:1.5;
  font-size:17px;-webkit-tap-highlight-color:transparent;min-height:100vh;
  background-image:radial-gradient(1200px 500px at 110% -10%,var(--mint) 0,transparent 60%),radial-gradient(900px 400px at -20% 0,var(--mint-50) 0,transparent 60%);
  background-attachment:fixed}
h1,h2,h3,h4{font-family:var(--font-display);line-height:1.2;margin:0 0 .4em;color:var(--teal);letter-spacing:-.01em}
h1{font-size:1.7rem} h2{font-size:1.4rem} h3{font-size:1.15rem}
p{margin:0 0 .8em}
a{color:var(--teal-600)}
button,input,textarea,select{font:inherit;color:inherit}
button{cursor:pointer}
:focus-visible{outline:3px solid var(--gold);outline-offset:3px;border-radius:10px}
.sr-only{position:absolute!important;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
[hidden]{display:none!important}

/* =========================================================================
   2. ESTRUCTURA: cabecera, contenido, navegación inferior
   ========================================================================= */
.app-header{position:sticky;top:0;z-index:20;display:flex;align-items:center;gap:10px;
  padding:calc(10px + env(safe-area-inset-top)) 16px 10px;background:color-mix(in srgb,var(--cream) 88%,transparent);
  backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.brand{display:flex;align-items:center;gap:10px;text-decoration:none;color:inherit;min-width:0}
.brand svg{width:42px;height:42px;flex:none}
.brand-name{font-family:var(--font-display);font-weight:800;color:var(--teal);font-size:1.08rem;line-height:1.1}
.brand-name span{color:var(--gold)}
.brand-tag{font-size:.78rem;color:var(--ink-soft);white-space:nowrap}
.header-actions{margin-left:auto;display:flex;gap:6px}
.icon-btn{width:44px;height:44px;border-radius:50%;border:1px solid var(--line);background:var(--paper);
  display:grid;place-items:center;font-size:1.15rem;transition:background .3s var(--ease)}
.icon-btn[aria-pressed="true"]{background:var(--teal);color:var(--cream);border-color:var(--teal)}
main{max-width:760px;margin:0 auto;padding:18px 16px calc(var(--nav-h) + 40px + env(safe-area-inset-bottom))}
.screen{animation:fadeUp var(--slow) var(--ease)}
@keyframes fadeUp{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}

.bottom-nav{position:fixed;left:0;right:0;bottom:0;z-index:30;display:flex;justify-content:space-around;
  background:var(--teal);padding:6px 6px calc(6px + env(safe-area-inset-bottom));
  border-radius:24px 24px 0 0;box-shadow:0 -8px 30px -12px rgba(18,51,48,.6)}
.bottom-nav button{flex:1;max-width:130px;background:none;border:0;color:var(--mint);display:flex;flex-direction:column;
  align-items:center;gap:2px;padding:8px 2px;border-radius:16px;font-size:.78rem;font-weight:600;min-height:56px;
  transition:background .4s var(--ease),color .4s var(--ease)}
.bottom-nav button .ico{font-size:1.35rem;line-height:1}
.bottom-nav button[aria-current="page"]{background:var(--teal-700);color:var(--paper)}
.bottom-nav button[aria-current="page"] .ico{transform:translateY(-1px)}
.bottom-nav button[aria-current="page"]::after{content:"";width:18px;height:3px;border-radius:3px;background:var(--gold);margin-top:2px}

/* =========================================================================
   3. COMPONENTES: tarjetas, botones, chips, segmentados
   ========================================================================= */
.card{background:var(--paper);border-radius:var(--radius);padding:18px;box-shadow:var(--shadow-soft);border:1px solid var(--line);margin-bottom:14px}
.card.mint{background:var(--mint-50);border-color:var(--mint-200)}
.card.teal{background:var(--teal);color:var(--cream);border-color:var(--teal)}
.card.teal h2,.card.teal h3{color:var(--paper)}
.card.gold{background:var(--gold-soft);border-color:#E7D3A0}
.eyebrow{font-size:.78rem;text-transform:uppercase;letter-spacing:.12em;font-weight:700;color:var(--gold);margin-bottom:4px}
.muted{color:var(--ink-soft)}
.small{font-size:.88rem}
.center{text-align:center}
.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
.grid2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
@media (min-width:620px){.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.grid2.wide{grid-template-columns:repeat(4,1fr)}}

.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:52px;padding:12px 22px;border-radius:999px;
  border:2px solid transparent;font-weight:700;font-size:1rem;text-decoration:none;transition:transform .3s var(--ease),background .3s var(--ease),box-shadow .3s var(--ease)}
.btn:active{transform:scale(.97)}
.btn-primary{background:var(--teal);color:var(--paper);box-shadow:var(--shadow)}
.btn-primary:hover{background:var(--teal-700)}
.btn-gold{background:var(--gold);color:var(--teal-950);box-shadow:0 10px 24px -12px rgba(201,162,77,.9)}
.btn-ghost{background:transparent;color:var(--teal);border-color:var(--teal)}
.btn-soft{background:var(--mint);color:var(--teal)}
.btn-light{background:var(--paper);color:var(--teal)}
.btn-block{width:100%}
.btn-xl{min-height:64px;font-size:1.15rem}
.btn-sm{min-height:42px;padding:8px 16px;font-size:.92rem}
.btn[disabled]{opacity:.5;cursor:not-allowed}

.chips{display:flex;gap:10px;flex-wrap:wrap}
.chip{min-height:52px;min-width:64px;padding:10px 16px;border-radius:18px;border:2px solid var(--line);background:var(--paper);
  font-weight:700;color:var(--teal);transition:all .35s var(--ease)}
.chip[aria-pressed="true"],.chip[aria-checked="true"]{background:var(--teal);color:var(--paper);border-color:var(--teal);box-shadow:var(--shadow)}
.chips.time .chip{flex:1;font-size:1.1rem}
.chips.time .chip small{display:block;font-size:.7rem;font-weight:600;opacity:.8}
.moods{display:grid;grid-template-columns:repeat(5,1fr);gap:8px}
.mood{border:2px solid var(--line);background:var(--paper);border-radius:18px;padding:10px 2px 8px;display:flex;flex-direction:column;align-items:center;gap:4px;
  font-size:.74rem;font-weight:700;color:var(--ink-soft);transition:all .35s var(--ease)}
.mood .e{font-size:1.9rem;line-height:1;transition:transform .4s var(--ease)}
.mood[aria-checked="true"]{border-color:var(--teal);background:var(--mint-50);color:var(--teal)}
.mood[aria-checked="true"] .e{transform:scale(1.15)}

.seg{display:flex;background:var(--mint-50);border:1px solid var(--mint-200);border-radius:999px;padding:4px;gap:4px;margin-bottom:16px;overflow-x:auto}
.seg button{flex:1;border:0;background:none;border-radius:999px;padding:10px 12px;font-weight:700;color:var(--teal-600);min-height:44px;white-space:nowrap;font-size:.92rem;transition:all .35s var(--ease)}
.seg button[aria-selected="true"]{background:var(--teal);color:var(--paper);box-shadow:var(--shadow-soft)}

.streak{display:flex;align-items:center;gap:12px}
.streak .leaf{width:46px;height:46px;border-radius:50%;background:var(--gold-soft);display:grid;place-items:center;font-size:1.4rem}
.badge{display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:999px;font-size:.8rem;font-weight:700;background:var(--mint);color:var(--teal)}

.progress{height:12px;border-radius:999px;background:var(--mint-50);overflow:hidden;border:1px solid var(--mint-200)}
.progress > i{display:block;height:100%;background:linear-gradient(90deg,var(--teal-600),var(--gold));border-radius:999px;transition:width .8s var(--ease)}

.list{list-style:none;padding:0;margin:0}
.list li{padding:10px 0;border-bottom:1px dashed var(--line);display:flex;gap:10px}
.list li:last-child{border-bottom:0}
.list .dot{flex:none;width:10px;height:10px;border-radius:50%;background:var(--gold);margin-top:8px}

.hscroll{display:flex;gap:12px;overflow-x:auto;scroll-snap-type:x mandatory;padding:4px 2px 12px;margin:0 -16px;padding-left:16px;padding-right:16px;scrollbar-width:thin}
.hscroll > *{scroll-snap-align:start;flex:0 0 78%;max-width:300px}
.tip{background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);padding:16px;box-shadow:var(--shadow-soft);margin:0}
.tip .n{display:inline-grid;place-items:center;width:30px;height:30px;border-radius:50%;background:var(--teal);color:var(--paper);font-weight:800;font-size:.9rem;margin-bottom:8px}

table.compare{width:100%;border-collapse:separate;border-spacing:0;font-size:.92rem;overflow:hidden;border-radius:var(--radius-sm);border:1px solid var(--line)}
table.compare th{background:var(--teal);color:var(--paper);padding:10px;text-align:left}
table.compare td{padding:10px;border-top:1px solid var(--line);vertical-align:top;background:var(--paper)}
table.compare td:first-child{font-weight:700;color:var(--teal);background:var(--mint-50);width:28%}

.game-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
@media (min-width:620px){.game-grid{grid-template-columns:repeat(4,1fr)}}
.game-card{border:1px solid var(--line);background:var(--paper);border-radius:var(--radius);padding:16px 12px;text-align:left;display:flex;flex-direction:column;gap:6px;
  min-height:150px;box-shadow:var(--shadow-soft);transition:transform .4s var(--ease),box-shadow .4s var(--ease)}
.game-card:hover{transform:translateY(-3px);box-shadow:var(--shadow)}
.game-card .gi{font-size:2rem;width:54px;height:54px;border-radius:18px;background:var(--mint-50);display:grid;place-items:center}
.game-card b{font-family:var(--font-display);color:var(--teal);font-size:1rem;line-height:1.2}
.game-card span{font-size:.8rem;color:var(--ink-soft)}

.notice{display:flex;gap:10px;align-items:flex-start;border-radius:var(--radius-sm);padding:12px 14px;background:var(--gold-soft);color:var(--teal-950);font-size:.92rem;border:1px solid #E7D3A0}
.notice.alert{background:var(--alert-bg);border-color:#EBC0B8}
.notice.mint{background:var(--mint-50);border-color:var(--mint-200)}

.toast{position:fixed;left:50%;bottom:calc(var(--nav-h) + 24px + env(safe-area-inset-bottom));transform:translateX(-50%) translateY(20px);background:var(--teal-950);color:var(--paper);
  padding:12px 20px;border-radius:999px;font-weight:600;opacity:0;pointer-events:none;transition:all .5s var(--ease);z-index:100;max-width:90vw;text-align:center}
.toast.show{opacity:1;transform:translateX(-50%)}

/* =========================================================================
   4. REPRODUCTOR DE PAUSA / JUEGOS (pantalla completa)
   ========================================================================= */
.overlay{position:fixed;inset:0;z-index:50;background:var(--cream);display:flex;flex-direction:column;animation:fadeUp .5s var(--ease)}
.overlay.dark{background:var(--teal-950);color:var(--cream)}
.ov-top{display:flex;align-items:center;gap:10px;padding:calc(10px + env(safe-area-inset-top)) 14px 10px;border-bottom:1px solid var(--line);background:var(--paper)}
.overlay.dark .ov-top{background:var(--teal);border-color:var(--teal-700)}
.ov-title{font-family:var(--font-display);font-weight:800;color:var(--teal);font-size:1.02rem;line-height:1.2;min-width:0;flex:1}
.overlay.dark .ov-title{color:var(--paper)}
.ov-title small{display:block;font-weight:600;font-size:.78rem;color:var(--ink-soft)}
.overlay.dark .ov-title small{color:var(--mint)}
.ov-body{flex:1;position:relative;overflow:auto;display:flex;flex-direction:column}
.ov-foot{display:flex;gap:8px;padding:10px 14px calc(10px + env(safe-area-inset-bottom));background:var(--paper);border-top:1px solid var(--line);flex-wrap:wrap;justify-content:center}
.btn-end{background:var(--gold);color:var(--teal-950);min-height:44px;padding:8px 16px;border-radius:999px;border:0;font-weight:800;white-space:nowrap}

.timer-ring{position:relative;width:76px;height:76px;flex:none}
.timer-ring svg{width:100%;height:100%;transform:rotate(-90deg)}
.timer-ring .bg{stroke:var(--mint)} .timer-ring .fg{stroke:var(--teal);transition:stroke-dashoffset 1s linear}
.timer-ring b{position:absolute;inset:0;display:grid;place-items:center;font-variant-numeric:tabular-nums;font-weight:800;color:var(--teal);font-size:1.05rem}
.steps-dots{display:flex;gap:6px;justify-content:center;margin:6px 0}
.steps-dots i{width:9px;height:9px;border-radius:50%;background:var(--mint-200);transition:all .4s var(--ease)}
.steps-dots i.on{background:var(--teal);width:24px;border-radius:9px}
.steps-dots i.done{background:var(--gold)}

.act-wrap{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:20px;text-align:center;gap:14px}
.act-emoji{font-size:4.2rem;line-height:1;animation:float 6s ease-in-out infinite}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}
.act-step{font-family:var(--font-display);font-size:1.45rem;font-weight:800;color:var(--teal);max-width:520px;min-height:3.6em;display:flex;align-items:center;justify-content:center}
.act-hint{color:var(--ink-soft);max-width:480px}

/* Círculo de respiración */
.breath{position:relative;width:min(70vw,300px);aspect-ratio:1;display:grid;place-items:center;margin:8px auto;touch-action:none;user-select:none;-webkit-user-select:none}
.breath .halo{position:absolute;inset:0;border-radius:50%;background:radial-gradient(circle,var(--mint) 0,transparent 70%)}
.breath .core{width:42%;aspect-ratio:1;border-radius:50%;background:radial-gradient(circle at 35% 30%,var(--teal-600),var(--teal));box-shadow:0 0 0 10px rgba(207,232,222,.6),0 20px 50px -18px rgba(31,78,74,.8);
  transform:scale(var(--s,1));transition:transform var(--dur,4s) cubic-bezier(.45,.05,.35,1),box-shadow .5s;display:grid;place-items:center;color:var(--paper)}
.breath .core.sync{box-shadow:0 0 0 14px rgba(201,162,77,.55),0 20px 50px -18px rgba(31,78,74,.8)}
.breath .label{position:absolute;bottom:-6px;left:0;right:0;text-align:center;font-family:var(--font-display);font-weight:800;font-size:1.5rem;color:var(--teal)}
.breath .count{font-size:1.6rem;font-weight:800;font-variant-numeric:tabular-nums;transform:scale(calc(1/var(--s,1)));transition:transform var(--dur,4s) cubic-bezier(.45,.05,.35,1)}
.overlay.dark .breath .label{color:var(--paper)}

/* Canvas de juegos */
.game-stage{position:relative;flex:1;min-height:320px;overflow:hidden;touch-action:none}
.game-stage canvas{position:absolute;inset:0;width:100%;height:100%;display:block}
.game-hud{position:absolute;top:10px;left:10px;right:10px;display:flex;justify-content:space-between;align-items:center;pointer-events:none;z-index:2}
.game-hud > *{pointer-events:auto}
.pill{background:rgba(255,255,255,.88);border:1px solid var(--line);border-radius:999px;padding:6px 14px;font-weight:700;color:var(--teal);font-size:.9rem}

/* Suelta tu preocupación */
.worry{width:100%;max-width:480px;margin:0 auto;padding:16px;display:flex;flex-direction:column;gap:12px;flex:1}
.paper{position:relative;background:var(--paper);border-radius:12px;box-shadow:var(--shadow);padding:18px;min-height:170px;border:1px solid var(--line);
  background-image:repeating-linear-gradient(transparent 0 31px,var(--mint) 31px 32px);transition:all 1s var(--ease);transform-origin:center}
.paper textarea{width:100%;min-height:140px;border:0;background:transparent;resize:none;font-size:1.1rem;line-height:32px;outline:none}
.paper.crumple{border-radius:50%;transform:scale(.25) rotate(260deg);filter:saturate(.3) brightness(.95);background-image:radial-gradient(circle at 30% 30%,#fff,#e9e4d8)}
.paper.crumple textarea{opacity:0;filter:blur(4px)}
.paper.throw{animation:throw 1.1s cubic-bezier(.4,0,.6,1) forwards}
@keyframes throw{0%{transform:translate(0,0) scale(.25) rotate(260deg)}45%{transform:translate(0,-90px) scale(.22) rotate(380deg)}100%{transform:translate(0,240px) scale(.1) rotate(560deg);opacity:0}}
.bin{width:110px;height:120px;margin:0 auto;position:relative}
.bin .lid{transform-origin:10% 100%;transition:transform .5s var(--ease)}
.bin.open .lid{transform:rotate(-28deg)}

/* Atrapa lo bueno */
.word{position:absolute;left:0;top:0;padding:10px 18px;border-radius:999px;background:var(--paper);border:2px solid var(--mint-200);color:var(--teal);font-weight:800;
  font-family:var(--font-display);box-shadow:var(--shadow-soft);white-space:nowrap;will-change:transform;font-size:1.05rem}
.word.got{background:var(--gold);border-color:var(--gold);color:var(--teal-950);transition:opacity .6s,transform .6s}
.collected{display:flex;flex-wrap:wrap;gap:6px;padding:10px 14px;background:var(--mint-50);border-top:1px solid var(--line);min-height:56px;align-items:center}

/* Memoria */
.mem-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;padding:16px;max-width:460px;margin:0 auto;width:100%}
@media (min-width:560px){.mem-grid{grid-template-columns:repeat(4,1fr)}}
.mcard{aspect-ratio:3/4;perspective:800px;border:0;background:none;padding:0}
.mcard .in{position:relative;width:100%;height:100%;transition:transform .7s var(--ease);transform-style:preserve-3d}
.mcard.flip .in{transform:rotateY(180deg)}
.mcard .f,.mcard .b{position:absolute;inset:0;border-radius:16px;display:flex;flex-direction:column;align-items:center;justify-content:center;backface-visibility:hidden;-webkit-backface-visibility:hidden;gap:4px}
.mcard .f{background:var(--teal);background-image:radial-gradient(circle at 50% 50%,var(--teal-600) 0 18%,transparent 19%),repeating-radial-gradient(circle at 50% 50%,transparent 0 10px,rgba(207,232,222,.12) 10px 12px);box-shadow:var(--shadow-soft)}
.mcard .b{background:var(--paper);border:2px solid var(--mint-200);transform:rotateY(180deg);font-weight:800;color:var(--teal);font-size:.85rem}
.mcard .b .e{font-size:2rem}
.mcard.match .b{border-color:var(--gold);background:var(--gold-soft)}

/* Mito o realidad */
.quiz{max-width:520px;margin:0 auto;padding:20px 16px;width:100%;display:flex;flex-direction:column;gap:14px}
.quiz .q{font-family:var(--font-display);font-size:1.35rem;font-weight:800;color:var(--teal);min-height:4em}
.feedback{border-radius:var(--radius-sm);padding:14px;animation:fadeUp .5s var(--ease)}
.feedback.good{background:var(--ok-bg)} .feedback.learn{background:var(--gold-soft)}

/* Mandala */
