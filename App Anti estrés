    '<div class="ov-top"><div class="timer-ring" aria-hidden="true"><svg viewBox="0 0 80 80"><circle class="bg" cx="40" cy="40" r="34" stroke-width="8" fill="none"/><circle class="fg" cx="40" cy="40" r="34" stroke-width="8" fill="none" stroke-linecap="round" stroke-dasharray="213.6" stroke-dashoffset="0"/></svg><b>1:00</b></div>' +
    '<div class="ov-title"><span class="act-name"></span><small class="act-meta"></small></div><button class="btn-end" data-act="end">Terminar pausa</button></div>' +
    '<div class="ov-body" id="actBody"></div>' +
